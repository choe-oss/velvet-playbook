<?xml version="1.0" encoding="utf-8"?>
<!--
    =============================================================================
    Velvet - OEM Default File Associations (OEMDefaultAssociations.xml)
    =============================================================================
-->
<DefaultAssociations>
  <!-- 웹 브라우저 & 프로토콜 (Google Chrome) -->
  <Association Identifier="http" ProgId="ChromeHTML" ApplicationName="Google Chrome" />
  <Association Identifier="https" ProgId="ChromeHTML" ApplicationName="Google Chrome" />
  <Association Identifier=".htm" ProgId="ChromeHTML" ApplicationName="Google Chrome" />
  <Association Identifier=".html" ProgId="ChromeHTML" ApplicationName="Google Chrome" />
  <Association Identifier=".shtml" ProgId="ChromeHTML" ApplicationName="Google Chrome" />
  <Association Identifier=".pdf" ProgId="ChromeHTML" ApplicationName="Google Chrome" />

  <!-- 압축 파일 (Bandizip) -->
  <Association Identifier=".zip" ProgId="Bandizip.ZIP" ApplicationName="Bandizip" />
  <Association Identifier=".7z" ProgId="Bandizip.7Z" ApplicationName="Bandizip" />
  <Association Identifier=".rar" ProgId="Bandizip.RAR" ApplicationName="Bandizip" />
  <Association Identifier=".tar" ProgId="Bandizip.TAR" ApplicationName="Bandizip" />
  <Association Identifier=".gz" ProgId="Bandizip.GZ" ApplicationName="Bandizip" />
  <Association Identifier=".tgz" ProgId="Bandizip.TGZ" ApplicationName="Bandizip" />
  <Association Identifier=".bz2" ProgId="Bandizip.BZ2" ApplicationName="Bandizip" />
  <Association Identifier=".xz" ProgId="Bandizip.XZ" ApplicationName="Bandizip" />
  <Association Identifier=".iso" ProgId="Bandizip.ISO" ApplicationName="Bandizip" />
  <Association Identifier=".cab" ProgId="Bandizip.CAB" ApplicationName="Bandizip" />
  <Association Identifier=".alz" ProgId="Bandizip.ALZ" ApplicationName="Bandizip" />
  <Association Identifier=".egg" ProgId="Bandizip.EGG" ApplicationName="Bandizip" />

  <!-- 미디어 & 동영상/오디오 (VLC media player) -->
  <Association Identifier=".mp4" ProgId="VLC.mp4" ApplicationName="VLC media player" />
  <Association Identifier=".mkv" ProgId="VLC.mkv" ApplicationName="VLC media player" />
  <Association Identifier=".avi" ProgId="VLC.avi" ApplicationName="VLC media player" />
  <Association Identifier=".mov" ProgId="VLC.mov" ApplicationName="VLC media player" />
  <Association Identifier=".wmv" ProgId="VLC.wmv" ApplicationName="VLC media player" />
  <Association Identifier=".flv" ProgId="VLC.flv" ApplicationName="VLC media player" />
  <Association Identifier=".webm" ProgId="VLC.webm" ApplicationName="VLC media player" />
  <Association Identifier=".mp3" ProgId="VLC.mp3" ApplicationName="VLC media player" />
  <Association Identifier=".flac" ProgId="VLC.flac" ApplicationName="VLC media player" />
  <Association Identifier=".wav" ProgId="VLC.wav" ApplicationName="VLC media player" />
  <Association Identifier=".aac" ProgId="VLC.aac" ApplicationName="VLC media player" />
  <Association Identifier=".m4a" ProgId="VLC.m4a" ApplicationName="VLC media player" />
  <Association Identifier=".ogg" ProgId="VLC.ogg" ApplicationName="VLC media player" />

  <!-- 문서 & 오피스 (ONLYOFFICE Desktop Editors) -->
  <Association Identifier=".docx" ProgId="ONLYOFFICE.docx" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".doc" ProgId="ONLYOFFICE.doc" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".xlsx" ProgId="ONLYOFFICE.xlsx" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".xls" ProgId="ONLYOFFICE.xls" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".pptx" ProgId="ONLYOFFICE.pptx" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".ppt" ProgId="ONLYOFFICE.ppt" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".odt" ProgId="ONLYOFFICE.odt" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".ods" ProgId="ONLYOFFICE.ods" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".odp" ProgId="ONLYOFFICE.odp" ApplicationName="ONLYOFFICE Desktop Editors" />
  <Association Identifier=".csv" ProgId="ONLYOFFICE.csv" ApplicationName="ONLYOFFICE Desktop Editors" />

  <!-- 이미지 파일 (qView / Windows Photo Viewer) -->
  <Association Identifier=".png" ProgId="qView.png" ApplicationName="qView" />
  <Association Identifier=".jpg" ProgId="qView.jpg" ApplicationName="qView" />
  <Association Identifier=".jpeg" ProgId="qView.jpeg" ApplicationName="qView" />
  <Association Identifier=".jfif" ProgId="qView.jfif" ApplicationName="qView" />
  <Association Identifier=".bmp" ProgId="qView.bmp" ApplicationName="qView" />
  <Association Identifier=".gif" ProgId="qView.gif" ApplicationName="qView" />
  <Association Identifier=".webp" ProgId="qView.webp" ApplicationName="qView" />
  <Association Identifier=".dib" ProgId="PhotoViewer.FileAssoc.Bitmap" ApplicationName="Windows Photo Viewer" />
  <Association Identifier=".tif" ProgId="PhotoViewer.FileAssoc.Tiff" ApplicationName="Windows Photo Viewer" />
  <Association Identifier=".tiff" ProgId="PhotoViewer.FileAssoc.Tiff" ApplicationName="Windows Photo Viewer" />

  <!-- 텍스트 & 개발 문서 (Notepad) -->
  <Association Identifier=".txt" ProgId="txtfile" ApplicationName="Notepad" />
  <Association Identifier=".log" ProgId="txtfile" ApplicationName="Notepad" />
  <Association Identifier=".ini" ProgId="inifile" ApplicationName="Notepad" />
  <Association Identifier=".inf" ProgId="inffile" ApplicationName="Notepad" />
  <Association Identifier=".cfg" ProgId="txtfile" ApplicationName="Notepad" />
  <Association Identifier=".md" ProgId="txtfile" ApplicationName="Notepad" />
  <Association Identifier=".json" ProgId="txtfile" ApplicationName="Notepad" />
  <Association Identifier=".xml" ProgId="xmlfile" ApplicationName="Notepad" />
  <Association Identifier=".yml" ProgId="txtfile" ApplicationName="Notepad" />
  <Association Identifier=".yaml" ProgId="txtfile" ApplicationName="Notepad" />
</DefaultAssociations>
